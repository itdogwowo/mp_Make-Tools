{
  "git_manage": "git_config.json",
  "esp_idf": {
    "chips": "esp32",
    "no_export": false
  },
  "build": {
    "dir": "build",
    "jobs": null,
    "user_c_modules": null,
    "strict": false,
    "no_doctor": false,
    "no_clean": false
  },
  "exmod": {
    "root": "ext_mod",
    "list": [
      "/lcd_bus/micropython.cmake",
      "/lcd_utils/micropython.cmake"
    ]
  },
  "esp32": {
    "partition": {
      "auto": true,
      "flash_mb": 4,
      "app_margin_kb": 4
    },
    "idf_component": {
      "dependencies": {
        "espressif/esp_new_jpeg": "^1.0.0"
      }
    }
  },
  "output": {
    "name": null
  }
}
