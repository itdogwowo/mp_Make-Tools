{
  "_notes": [
    "範例設定。flash_mb 建議明寫成「你們會出貨的最小 flash」當作安全 floor：",
    "宣告小於實際晶片 → 到處都能開機；宣告大於實際 → bootloader 會 Probe failed。",
    "省略 flash_mb 時會沿 board 的 sdkconfig 鏈自動偵測，換 board 時值會跟著變。"
  ],
  "git_manage": "git_config.json",
  "esp_idf": {
    "no_export": false
  },
  "build": {
    "target": "esp32s3",
    "dir": "build",
    "jobs": null,
    "user_c_modules": null,
    "strict": false,
    "no_doctor": false,
    "no_clean": false
  },
  "exmod": {
    "root": "ext_mod",
    "list": []
  },
  "esp32": {
    "partition": {
      "auto": true,
      "flash_mb": 4,
      "app_margin_kb": 4
    },
    "sdkconfig": {},
    "idf_component": {
      "dependencies": {
        "espressif/esp_new_jpeg": "^1.0.0"
      }
    },
    "make": {
      "_comment": "C5_WIFI,SPIRAM_OCT",
      "vars": {
        "BOARD": "ESP32_GENERIC_S3",
        "BOARD_VARIANT": "SPIRAM_OCT"
      }
    }
  },
  "output": {
    "name": null
  }
}
