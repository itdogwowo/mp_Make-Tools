{
  "_notes": [
    "ESP32-S3，quad PSRAM 80MHz，CPU 240MHz，4MB flash。",
    "PSRAM 由 boards/mpconfigboard_esp32s3_common.cmake 的 sdkconfig.spiram_quad 開啟（含 CONFIG_SPIRAM=y）。",
    "git_manage 必須設，否則 git manager 整段不會執行（cli.py 的 if cfg.git_manage），pin 會失效。",
    "所有 S3/S31 preset 共用根目錄的 git_config.json；要換來源版本請 cp ports/_stacks/<stack>.json 過去。",
    "不寫 flash_mb —— 由工具沿 board 的 sdkconfig 鏈自動偵測（此板 = 4MB）。"
  ],
  "git_manage": "git_config.json",
  "esp_idf": {
    "chips": "esp32s3",
    "no_export": false
  },
  "build": {
    "target": "esp32s3",
    "dir": "build",
    "jobs": null,
    "user_c_modules": null,
    "strict": false,
    "no_doctor": false,
    "no_clean": false
  },
  "exmod": {
    "root": "ext_mod",
    "list": [
      "/mp_jpeg/micropython.cmake",
      "/mp_hub75/micropython.cmake",
      "/mp_heap_caps/micropython.cmake",
      "/mp_lcd_bus/micropython.cmake",
      "/lv_binding_micropython/micropython.cmake"
    ]
  },
  "esp32": {
    "partition": {
      "auto": true,
      "app_margin_kb": 4
    },
    "sdkconfig": {
      "esp32s3": {
        "CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_40": "",
        "CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_80": "",
        "CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160": "",
        "CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240": "y",
        "CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ": "240"
      }
    },
    "idf_component": {
      "dependencies": {
        "espressif/esp_new_jpeg": "^1.0.0",
        "esphome/esp-hub75": "^0.3.6"
      }
    },
    "make": {
      "vars": {
        "BOARD": "ESP32_GENERIC_S3",
        "BOARD_VARIANT": ""
      }
    }
  },
  "output": {
    "name": "s3-quad"
  }
}
