{
  "_notes": [
    "ESP32-S31，16MB flash，octal PSRAM 250MHz（此晶片的上限），CPU 320MHz。",
    "S31 的 PSRAM 速度選項是 40/100/200/250MHz，IDF 預設 200MHz；這裡拉到上限 250MHz。",
    "若真機不穩（當機、開不了機），先換成 s31-psram200 再测。",
    "注意：sdkconfig 區塊內不可放 _comment 之類的鍵，會被原樣寫進 sdkconfig 片段。"
  ],
  "git_manage": "git_config.json",
  "esp_idf": {
    "chips": "esp32s31",
    "no_export": false
  },
  "build": {
    "target": "esp32s31",
    "dir": "build",
    "jobs": null,
    "user_c_modules": null,
    "strict": false,
    "no_doctor": false,
    "no_clean": false
  },
  "exmod": {
    "root": "ext_mod",
    "list": [
      "/mp_jpeg/micropython.cmake",
      "/mp_hub75/micropython.cmake",
      "/mp_heap_caps/micropython.cmake",
      "/mp_lcd_bus/micropython.cmake",
      "/lv_binding_micropython/micropython.cmake"
    ]
  },
  "esp32": {
    "partition": {
      "auto": true,
      "app_margin_kb": 4
    },
    "sdkconfig": {
      "esp32s31": {
        "CONFIG_SPIRAM": "y",
        "CONFIG_SPIRAM_MODE_OCT": "y",
        "CONFIG_SPIRAM_SPEED_250M": "y",
        "CONFIG_SPIRAM_SPEED_200M": "",
        "CONFIG_SPIRAM_SPEED_100M": "",
        "CONFIG_SPIRAM_SPEED_40M": "",
        "CONFIG_SPIRAM_SPEED": "250",
        "CONFIG_SPIRAM_BOOT_INIT": "y",
        "CONFIG_SPIRAM_IGNORE_NOTFOUND": "y",
        "CONFIG_SPIRAM_USE_MALLOC": "y",
        "CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL": "8192"
      }
    },
    "idf_component": {
      "dependencies": {
        "espressif/esp_new_jpeg": "^1.0.0",
        "esphome/esp-hub75": "^0.3.6"
      }
    },
    "make": {
      "vars": {
        "BOARD": "ESP32_GENERIC_S31",
        "BOARD_VARIANT": ""
      }
    }
  },
  "output": {
    "name": "s31-psram250"
  }
}
