{
  "_notes": [
    "ESP32-S3，octal PSRAM 80MHz（BOARD_VARIANT=SPIRAM_OCT），CPU 240MHz，4MB flash。",
    "變體 mpconfigvariant_SPIRAM_OCT.cmake 會再疊上 sdkconfig.spiram_oct（把模式切成 OCT）；",
    "速度仍是 80MHz，因為 base 的 sdkconfig.spiram_quad 已經設了 CONFIG_SPIRAM_SPEED_80M=y。",
    "注意：octal 上 120MHz 是 IDF 標示的實驗性選項（溫差約 20C 會隨機崩），所以不採用。"
  ],
  "git_manage": "git_config.json",
  "esp_idf": {
    "chips": "esp32s3",
    "no_export": false
  },
  "build": {
    "target": "esp32s3",
    "dir": "build",
    "jobs": null,
    "user_c_modules": null,
    "strict": false,
    "no_doctor": false,
    "no_clean": false
  },
  "exmod": {
    "root": "ext_mod",
    "list": [
      "/mp_jpeg/micropython.cmake",
      "/mp_hub75/micropython.cmake",
      "/mp_heap_caps/micropython.cmake",
      "/mp_lcd_bus/micropython.cmake",
      "/lv_binding_micropython/micropython.cmake"
    ]
  },
  "esp32": {
    "partition": {
      "auto": true,
      "app_margin_kb": 4
    },
    "sdkconfig": {
      "esp32s3": {
        "CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_40": "",
        "CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_80": "",
        "CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160": "",
        "CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240": "y",
        "CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ": "240"
      }
    },
    "idf_component": {
      "dependencies": {
        "espressif/esp_new_jpeg": "^1.0.0",
        "esphome/esp-hub75": "^0.3.6"
      }
    },
    "make": {
      "vars": {
        "BOARD": "ESP32_GENERIC_S3",
        "BOARD_VARIANT": "SPIRAM_OCT"
      }
    }
  },
  "output": {
    "name": "s3-oct"
  }
}
