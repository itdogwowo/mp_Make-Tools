{
  "_notes": [
    "預設設定。flash_mb 刻意固定成 4 —— 這是「安全 floor」。",
    "理由：宣告小於實際晶片 → 到處都能開機（只是用不到多的空間）；",
    "      宣告大於實際晶片 → bootloader 會報 Probe failed，直接開不了機。",
    "所以這裡採用出貨模組的最小值，需要更大空間時由燒錄端處理（重寫 vfs 分割區）。",
    "省略 flash_mb 會改成沿 board 的 sdkconfig 鏈自動偵測 —— 注意 ESP32_GENERIC_P4 宣告的是 16MB。"
  ],
  "git_manage": "git_config.json",
  "esp_idf": {
    "chips": "esp32,esp32s3,esp32p4",
    "no_export": false
  },
  "build": {
    "target": "esp32s3",
    "dir": "build",
    "jobs": null,
    "user_c_modules": null,
    "strict": false,
    "no_doctor": false,
    "no_clean": false
  },
  "exmod": {
    "root": "ext_mod",
    "list": [
      "/mp_jpeg/micropython.cmake",
      "/mp_hub75/micropython.cmake",
      "/mp_heap_caps/micropython.cmake",
      "/mp_lcd_bus/micropython.cmake",
      "/lv_binding_micropython/micropython.cmake"
    ]
  },
  "esp32": {
    "partition": {
      "auto": true,
      "flash_mb": 4,
      "app_margin_kb": 4
    },
    "sdkconfig": {
      "esp32p4": {
        "CONFIG_ESP32P4_REV_MIN_300": "n",
        "CONFIG_ESP32P4_REV_MIN_0": "y",
        "CONFIG_ESP32P4_SELECTS_REV_LESS_V3": "y"
      }
    },
    "idf_component": {
      "dependencies": {
        "espressif/esp_new_jpeg": "^1.0.0",
        "esphome/esp-hub75": "^0.3.6"
      }
    },
    "make": {
      "_comment": "C5_WIFI,SPIRAM_OCT",
      "vars": {
        "BOARD": "ESP32_GENERIC_P4",
        "BOARD_VARIANT": "C6_WIFI"
      }
    }
  },
  "output": {
    "name": null
  }
}
